export extern class HtmlOptions {
  JsValue allowDangerousHtml;
}

export extern class CompileHost {
  JsValue compiler;
  JsValue data;
}

export bool optionFlag(JsValue value, bool fallback) {
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return fallback;
  }
  return value.truthy();
}

export int arrLen(JsValue arr) {
  return JS.number(arr["length"]).toInt();
}

export string asString(JsValue value) {
  if (value is string) {
    return value;
  }
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return "";
  }
  return JS.string(value);
}

export string nodeType(JsValue node) {
  JsValue t = node["type"];
  if (t is string) {
    return t;
  }
  return "";
}

export bool allowHtmlFrom(JsValue self, JsValue options) {
  HtmlOptions direct = JS.assume(JS.object());
  if (!JS.isUndefined(options) && !JS.isNullish(options)) {
    direct = JS.assume(options);
  }
  bool allow = optionFlag(direct.allowDangerousHtml, false);
  CompileHost host = JS.assume(self);
  JsValue dataFn = host.data;
  if (JS.typeOf(dataFn) == "function") {
    JsValue bag = JS.call(dataFn, self);
    if (!JS.isUndefined(bag) && !JS.isNullish(bag)) {
      JsValue settings = JS.get(bag, "settings");
      if (!JS.isUndefined(settings) && !JS.isNullish(settings)) {
        HtmlOptions fromData = JS.assume(settings);
        allow = optionFlag(direct.allowDangerousHtml, optionFlag(fromData.allowDangerousHtml, false));
      }
    }
  }
  return allow;
}

export bool isVoidTag(string tag) {
  return tag == "area" || tag == "base" || tag == "br" || tag == "col" || tag == "embed" || tag == "hr" || tag == "img" || tag == "input" || tag == "link" || tag == "meta" || tag == "param" || tag == "source" || tag == "track" || tag == "wbr";
}

export string escapeText(string src) {
  Regex amp = new Regex("&", "g");
  amp.lastIndex = 0;
  string a = src.replace(amp, "&amp;");
  Regex lt = new Regex("<", "g");
  lt.lastIndex = 0;
  string b = a.replace(lt, "&lt;");
  Regex gt = new Regex(">", "g");
  gt.lastIndex = 0;
  return b.replace(gt, "&gt;");
}

export string escapeAttr(string src) {
  string a = escapeText(src);
  Regex quot = new Regex("\"", "g");
  quot.lastIndex = 0;
  return a.replace(quot, "&quot;");
}
