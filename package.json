{
  "name": "@itslil/rehype-stringify",
  "version": "10.0.1",
  "description": "rehype-stringify reimplemented in LilScript",
  "keywords": [
    "rehype",
    "html",
    "stringify",
    "hast",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/rehype-stringifylil/",
  "bugs": "https://github.com/yeargun/rehype-stringifylil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/rehype-stringifylil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/rehype-stringify.cjs",
  "module": "./dist/rehype-stringify.esm.js",
  "types": "./dist/rehype-stringify.d.ts",
  "unpkg": "./dist/rehype-stringify.umd.js",
  "jsdelivr": "./dist/rehype-stringify.umd.js",
  "exports": {
    ".": {
      "types": "./dist/rehype-stringify.d.ts",
      "import": "./dist/rehype-stringify.esm.js",
      "require": "./dist/rehype-stringify.cjs",
      "default": "./dist/rehype-stringify.esm.js"
    },
    "./closed": "./dist/rehype-stringify.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/rehype-stringify.esm.js",
    "dist/rehype-stringify.cjs",
    "dist/rehype-stringify.umd.js",
    "dist/rehype-stringify.closed.js",
    "dist/rehype-stringify.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test test/*.test.mjs",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check:pack && npm run check:site"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
